<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Business Rules Schema
  Defines structure for extracted business rules (business-rules.xml)
  Version: 1.0.0
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/business-rules"
           targetNamespace="http://reforge.dev/schema/business-rules"
           elementFormDefault="qualified">

  <!-- Shared Types -->
  <xs:simpleType name="ConfidenceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="high"/>
      <xs:enumeration value="medium"/>
      <xs:enumeration value="low"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="SourceReferenceType">
    <xs:sequence>
      <xs:element name="snippet" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="file" type="xs:string" use="required"/>
    <xs:attribute name="line-start" type="xs:integer" use="required"/>
    <xs:attribute name="line-end" type="xs:integer" use="required"/>
  </xs:complexType>

  <!-- Root Element -->
  <xs:element name="business-rules">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rule" type="rf:BusinessRuleType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="project-id" type="xs:string" use="required"/>
      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="generated" type="xs:dateTime" use="required"/>
      <xs:attribute name="count" type="xs:integer" use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- Business Rule -->
  <xs:complexType name="BusinessRuleType">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="logic" type="xs:string"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
      <xs:element name="entities" type="rf:EntitiesRefType" minOccurs="0"/>
      <xs:element name="related-rules" type="rf:RelatedRulesType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Entity References -->
  <xs:complexType name="EntitiesRefType">
    <xs:sequence>
      <xs:element name="entity" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Related Rules -->
  <xs:complexType name="RelatedRulesType">
    <xs:sequence>
      <xs:element name="rule-ref" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="relationship" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
