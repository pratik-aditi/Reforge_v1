#!/usr/bin/env bash
set -euo pipefail

# ─── Self-Location ───────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REFORGE_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
FRAMEWORK_VERSION="1.0.0"

# ─── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ─── Helpers ─────────────────────────────────────────────────────────────────
info()  { echo -e "${BLUE}[reforge]${NC} $*"; }
ok()    { echo -e "${GREEN}[reforge]${NC} $*"; }
warn()  { echo -e "${YELLOW}[reforge]${NC} $*"; }
err()   { echo -e "${RED}[reforge]${NC} $*" >&2; }
die()   { err "$@"; exit 1; }

# ─── Usage ───────────────────────────────────────────────────────────────────
show_help() {
  cat <<'EOF'
Usage: reforge <--claude|--remove> [OPTIONS] [target-path]

Commands:
  --claude              Install/set up Reforge for Claude Code
  --remove              Remove Reforge from target project

Options:
  --update              Refresh framework files (preserves config)
  --force               Skip confirmation prompts
  --dry-run             Show what would be done
  --version             Show framework version
  --help                Show help

Arguments:
  target-path           Target project directory (defaults to current directory)

Examples:
  reforge --claude .                      Install into current directory
  reforge --claude /opt/legacy-app        Install into specific project
  reforge --claude --update .             Update after pulling new framework version
  reforge --remove .                      Uninstall from current directory
EOF
}

# ─── Validation ──────────────────────────────────────────────────────────────
validate_source() {
  if [[ ! -d "$REFORGE_HOME/.reforge/commands" ]]; then
    die "Framework source incomplete: $REFORGE_HOME/.reforge/commands/ not found"
  fi
  if [[ ! -f "$REFORGE_HOME/.reforge/config.json" ]]; then
    die "Framework source incomplete: $REFORGE_HOME/.reforge/config.json not found"
  fi
}

validate_target() {
  local target="$1"
  if [[ ! -d "$target" ]]; then
    die "Target directory does not exist: $target"
  fi

  # Resolve both to absolute paths for comparison
  local abs_target abs_home
  abs_target="$(cd "$target" && pwd)"
  abs_home="$REFORGE_HOME"

  if [[ "$abs_target" == "$abs_home" ]]; then
    die "Cannot install into the framework repository itself: $abs_target"
  fi
}

# ─── Copy Framework ─────────────────────────────────────────────────────────
copy_framework() {
  local target="$1"
  local dry_run="$2"

  local dirs=(
    "commands"
    "schemas"
    "templates"
    "scripts/bash"
  )

  for dir in "${dirs[@]}"; do
    local src="$REFORGE_HOME/.reforge/$dir"
    local dst="$target/.reforge/$dir"
    if [[ -d "$src" ]]; then
      if [[ "$dry_run" == "true" ]]; then
        info "Would copy: .reforge/$dir/"
      else
        mkdir -p "$dst"
        cp -R "$src"/ "$dst"/
      fi
    fi
  done

  # Single files
  local files=(
    "memory/constitution.md"
    "config.json"
    "README.md"
  )

  for file in "${files[@]}"; do
    local src="$REFORGE_HOME/.reforge/$file"
    local dst="$target/.reforge/$file"
    if [[ -f "$src" ]]; then
      if [[ "$dry_run" == "true" ]]; then
        info "Would copy: .reforge/$file"
      else
        mkdir -p "$(dirname "$dst")"
        cp "$src" "$dst"
      fi
    fi
  done

  # Write version stamp
  if [[ "$dry_run" == "true" ]]; then
    info "Would write: .reforge/.version"
  else
    echo "$FRAMEWORK_VERSION" > "$target/.reforge/.version"
  fi
}

# ─── Create Memory Directories ──────────────────────────────────────────────
create_memory_dirs() {
  local target="$1"
  local dry_run="$2"

  local dirs=(
    ".reforge/memory/history"
    ".reforge/memory/backups"
    ".reforge/memory/checkpoints"
    ".reforge/memory/clarifications"
    ".reforge/memory/logs"
    ".reforge/memory/analysis"
  )

  for dir in "${dirs[@]}"; do
    if [[ "$dry_run" == "true" ]]; then
      info "Would create: $dir/"
    else
      mkdir -p "$target/$dir"
    fi
  done
}

# ─── Generate Wrappers ──────────────────────────────────────────────────────
generate_wrappers() {
  local target="$1"
  local dry_run="$2"

  local cmd_dir="$REFORGE_HOME/.reforge/commands"

  if [[ "$dry_run" == "true" ]]; then
    info "Would create: .claude/commands/ wrappers"
  else
    mkdir -p "$target/.claude/commands"
  fi

  for cmd_file in "$cmd_dir"/*.md; do
    local name
    name="$(basename "$cmd_file" .md)"

    # Extract description from first > blockquote line
    local description
    description="$(grep -m1 '^>' "$cmd_file" | sed 's/^> *//')"
    if [[ -z "$description" ]]; then
      description="Run reforge $name command"
    fi

    local wrapper_path="$target/.claude/commands/reforge.${name}.md"

    if [[ "$dry_run" == "true" ]]; then
      info "  Would create: .claude/commands/reforge.${name}.md"
    else
      cat > "$wrapper_path" <<WRAPPER
---
description: ${description}
---

## User Input

\`\`\`text
\$ARGUMENTS
\`\`\`

You **MUST** consider the user input before proceeding (if not empty).

## Execution

Load and execute the full command template at \`.reforge/commands/${name}.md\`.
Follow all steps defined in that file exactly as written, passing through any
arguments provided above.
WRAPPER
    fi
  done
}

# ─── Merge Settings ──────────────────────────────────────────────────────────
merge_settings() {
  local target="$1"
  local dry_run="$2"

  local settings_file="$target/.claude/settings.local.json"
  local permissions=(
    'Bash(bash .reforge/scripts/bash/init-project.sh:*)'
    'Bash(bash .reforge/scripts/bash/check-prerequisites.sh:*)'
    'Bash(bash .reforge/scripts/bash/manage-checkpoint.sh:*)'
    'Bash(bash .reforge/scripts/bash/update-agent-context.sh:*)'
  )

  if [[ "$dry_run" == "true" ]]; then
    info "Would update: .claude/settings.local.json with reforge permissions"
    return
  fi

  mkdir -p "$target/.claude"

  if [[ -f "$settings_file" ]]; then
    # File exists — merge permissions into existing allow array
    local tmp_file="${settings_file}.tmp"
    local needs_update=false

    for perm in "${permissions[@]}"; do
      if ! grep -qF "$perm" "$settings_file"; then
        needs_update=true
        break
      fi
    done

    if [[ "$needs_update" == "true" ]]; then
      # Build the new permissions entries
      local new_entries=""
      for perm in "${permissions[@]}"; do
        if ! grep -qF "$perm" "$settings_file"; then
          new_entries="${new_entries}    \"${perm}\",\n"
        fi
      done

      if grep -q '"allow"' "$settings_file"; then
        # Insert after "allow": [
        sed 's/"allow": \[/"allow": [\n'"$(echo -e "$new_entries" | sed 's/\//\\\//g')"'/' "$settings_file" > "$tmp_file"
        mv "$tmp_file" "$settings_file"
      else
        # No allow key — add one. Insert before final }
        local insert
        insert="  \"allow\": [\n"
        for i in "${!permissions[@]}"; do
          insert="${insert}    \"${permissions[$i]}\""
          if [[ $i -lt $((${#permissions[@]} - 1)) ]]; then
            insert="${insert},"
          fi
          insert="${insert}\n"
        done
        insert="${insert}  ]"
        # Use awk to insert before closing brace
        awk -v ins="$insert" '
          /^}/ { printf "%s\n", ins; print; next }
          { print }
        ' "$settings_file" > "$tmp_file"
        mv "$tmp_file" "$settings_file"
      fi
    fi
  else
    # Create fresh settings file
    {
      echo '{'
      echo '  "allow": ['
      for i in "${!permissions[@]}"; do
        if [[ $i -lt $((${#permissions[@]} - 1)) ]]; then
          echo "    \"${permissions[$i]}\","
        else
          echo "    \"${permissions[$i]}\""
        fi
      done
      echo '  ]'
      echo '}'
    } > "$settings_file"
  fi
}

# ─── Update Gitignore ────────────────────────────────────────────────────────
update_gitignore() {
  local target="$1"
  local dry_run="$2"

  local gitignore="$target/.gitignore"
  local entries=(
    "reforge_output/"
    ".reforge/memory/checkpoints/"
    ".reforge/memory/clarifications/"
    ".reforge/memory/logs/"
  )
  local header="# Reforge Framework (runtime state)"

  if [[ "$dry_run" == "true" ]]; then
    info "Would update: .gitignore with reforge entries"
    return
  fi

  # Check if header already present
  if [[ -f "$gitignore" ]] && grep -qF "$header" "$gitignore"; then
    return
  fi

  # Append entries
  {
    echo ""
    echo "$header"
    for entry in "${entries[@]}"; do
      echo "$entry"
    done
  } >> "$gitignore"
}

# ─── Config Merge (--update) ─────────────────────────────────────────────────
merge_config() {
  local target="$1"
  local dry_run="$2"

  local existing="$target/.reforge/config.json"
  local new_config="$REFORGE_HOME/.reforge/config.json"

  if [[ ! -f "$existing" ]]; then
    # No existing config, just copy
    if [[ "$dry_run" == "true" ]]; then
      info "Would copy: .reforge/config.json (fresh)"
    else
      cp "$new_config" "$existing"
    fi
    return
  fi

  if [[ "$dry_run" == "true" ]]; then
    info "Would merge: .reforge/config.json (preserving user fields)"
    return
  fi

  # Back up existing config
  cp "$existing" "${existing}.bak"

  # Extract user-modifiable fields from existing config using awk
  local project_name project_root project_desc output_dir
  local confidence snippets snippet_lines
  project_name="$(awk -F'"' '/"name"/ && !found_name {print $4; found_name=1}' "$existing")"
  project_root="$(awk -F'"' '/"root"/ {print $4}' "$existing")"
  project_desc="$(awk -F'"' '/"description"/ && !found_desc {print $4; found_desc=1}' "$existing")"
  output_dir="$(awk -F'"' '/"directory"/ {print $4}' "$existing")"
  confidence="$(awk -F'"' '/"confidenceThreshold"/ {print $4}' "$existing")"
  snippets="$(awk '/"includeSnippets"/ {gsub(/[^a-z]/, "", $2); print $2}' "$existing")"
  snippet_lines="$(awk '/"maxSnippetLines"/ {gsub(/[^0-9]/, "", $2); print $2}' "$existing")"

  # Extract user exclusions (lines between "exclusions": [ and ])
  local user_exclusions
  user_exclusions="$(awk '
    /"exclusions"/ { in_exc=1; next }
    in_exc && /\]/ { in_exc=0; next }
    in_exc { print }
  ' "$existing")"

  # Copy new config as base
  cp "$new_config" "$existing"

  # Patch user fields back in
  if [[ -n "$project_name" ]]; then
    sed -i '' 's/"name": ""/"name": "'"$project_name"'"/' "$existing" 2>/dev/null || \
    sed -i 's/"name": ""/"name": "'"$project_name"'"/' "$existing"
  fi
  if [[ -n "$project_desc" ]]; then
    sed -i '' 's/"description": ""/"description": "'"$project_desc"'"/' "$existing" 2>/dev/null || \
    sed -i 's/"description": ""/"description": "'"$project_desc"'"/' "$existing"
  fi
  if [[ -n "$output_dir" && "$output_dir" != "reforge_output" ]]; then
    sed -i '' 's|"directory": "reforge_output"|"directory": "'"$output_dir"'"|' "$existing" 2>/dev/null || \
    sed -i 's|"directory": "reforge_output"|"directory": "'"$output_dir"'"|' "$existing"
  fi
  if [[ -n "$confidence" && "$confidence" != "medium" ]]; then
    sed -i '' 's/"confidenceThreshold": "medium"/"confidenceThreshold": "'"$confidence"'"/' "$existing" 2>/dev/null || \
    sed -i 's/"confidenceThreshold": "medium"/"confidenceThreshold": "'"$confidence"'"/' "$existing"
  fi

  ok "Config merged (backup at config.json.bak)"
}

# ─── Install ─────────────────────────────────────────────────────────────────
do_install() {
  local target="$1"
  local dry_run="$2"

  # Check if already installed
  if [[ -d "$target/.reforge" ]]; then
    die "Target already has .reforge/ directory. Use --update to refresh, or --remove first."
  fi

  info "Installing Reforge framework into: $target"

  copy_framework "$target" "$dry_run"
  create_memory_dirs "$target" "$dry_run"
  generate_wrappers "$target" "$dry_run"
  merge_settings "$target" "$dry_run"
  update_gitignore "$target" "$dry_run"

  if [[ "$dry_run" == "true" ]]; then
    echo ""
    info "Dry run complete. No changes made."
  else
    echo ""
    ok "Reforge v${FRAMEWORK_VERSION} installed successfully!"
    info "Run /reforge.analyze in Claude Code to begin codebase analysis."
  fi
}

# ─── Update ──────────────────────────────────────────────────────────────────
do_update() {
  local target="$1"
  local dry_run="$2"

  if [[ ! -d "$target/.reforge" ]]; then
    die "No .reforge/ directory found. Run initial install first (without --update)."
  fi

  info "Updating Reforge framework in: $target"

  # Update framework files (commands, schemas, templates, scripts)
  local dirs=("commands" "schemas" "templates" "scripts/bash")
  for dir in "${dirs[@]}"; do
    local src="$REFORGE_HOME/.reforge/$dir"
    local dst="$target/.reforge/$dir"
    if [[ -d "$src" ]]; then
      if [[ "$dry_run" == "true" ]]; then
        info "Would refresh: .reforge/$dir/"
      else
        mkdir -p "$dst"
        cp -R "$src"/ "$dst"/
      fi
    fi
  done

  # Update constitution and README
  for file in "memory/constitution.md" "README.md"; do
    local src="$REFORGE_HOME/.reforge/$file"
    if [[ -f "$src" ]]; then
      if [[ "$dry_run" == "true" ]]; then
        info "Would refresh: .reforge/$file"
      else
        mkdir -p "$(dirname "$target/.reforge/$file")"
        cp "$src" "$target/.reforge/$file"
      fi
    fi
  done

  # Merge config (preserving user fields)
  merge_config "$target" "$dry_run"

  # Update version stamp
  if [[ "$dry_run" == "true" ]]; then
    info "Would update: .reforge/.version"
  else
    echo "$FRAMEWORK_VERSION" > "$target/.reforge/.version"
  fi

  # Regenerate wrappers
  generate_wrappers "$target" "$dry_run"

  # Ensure settings and gitignore are up to date
  merge_settings "$target" "$dry_run"
  update_gitignore "$target" "$dry_run"

  if [[ "$dry_run" == "true" ]]; then
    echo ""
    info "Dry run complete. No changes made."
  else
    echo ""
    ok "Reforge updated to v${FRAMEWORK_VERSION}!"
  fi
}

# ─── Remove ──────────────────────────────────────────────────────────────────
do_remove() {
  local target="$1"
  local force="$2"
  local dry_run="$3"

  if [[ ! -d "$target/.reforge" ]]; then
    die "No .reforge/ directory found in: $target"
  fi

  if [[ "$dry_run" == "true" ]]; then
    info "Would remove: .reforge/"
    info "Would remove: .claude/commands/reforge.*.md"
    info "Would remove reforge permissions from: .claude/settings.local.json"
    info "Would remove reforge entries from: .gitignore"
    echo ""
    info "Dry run complete. No changes made."
    return
  fi

  # Confirmation
  if [[ "$force" != "true" ]]; then
    echo ""
    warn "This will remove:"
    echo "  - .reforge/ directory"
    echo "  - .claude/commands/reforge.*.md wrappers"
    echo "  - Reforge permissions from .claude/settings.local.json"
    echo "  - Reforge entries from .gitignore"
    echo ""
    read -rp "Continue? [y/N] " confirm
    if [[ "$confirm" != [yY]* ]]; then
      info "Aborted."
      exit 0
    fi
  fi

  # Remove .reforge directory
  rm -rf "$target/.reforge"
  ok "Removed .reforge/"

  # Remove wrapper commands
  rm -f "$target/.claude/commands"/reforge.*.md
  ok "Removed .claude/commands/reforge.*.md"

  # Clean settings.local.json
  local settings_file="$target/.claude/settings.local.json"
  if [[ -f "$settings_file" ]]; then
    local tmp_file="${settings_file}.tmp"
    grep -v '\.reforge/scripts/bash/' "$settings_file" > "$tmp_file" || true
    # Clean up trailing commas in JSON array
    awk '
      { lines[NR] = $0 }
      END {
        for (i = 1; i <= NR; i++) {
          line = lines[i]
          # Remove trailing comma if next non-empty line is ] or }
          if (line ~ /,$/) {
            j = i + 1
            while (j <= NR && lines[j] ~ /^[[:space:]]*$/) j++
            if (j <= NR && lines[j] ~ /^[[:space:]]*[\]}]/) {
              sub(/,$/, "", line)
            }
          }
          print line
        }
      }
    ' "$tmp_file" > "$settings_file"
    rm -f "$tmp_file"
    ok "Cleaned .claude/settings.local.json"
  fi

  # Clean gitignore
  local gitignore="$target/.gitignore"
  if [[ -f "$gitignore" ]]; then
    local tmp_file="${gitignore}.tmp"
    sed '/# Reforge Framework (runtime state)/,/^$/d' "$gitignore" > "$tmp_file"
    mv "$tmp_file" "$gitignore"
    ok "Cleaned .gitignore"
  fi

  echo ""
  ok "Reforge removed from: $target"

  # Prompt about output directory
  if [[ -d "$target/reforge_output" ]]; then
    echo ""
    warn "Note: reforge_output/ still exists (your analysis data)."
    if [[ "$force" != "true" ]]; then
      read -rp "Remove reforge_output/ as well? [y/N] " confirm_output
      if [[ "$confirm_output" == [yY]* ]]; then
        rm -rf "$target/reforge_output"
        ok "Removed reforge_output/"
      else
        info "Kept reforge_output/"
      fi
    else
      info "Kept reforge_output/ (use rm -rf to remove manually)"
    fi
  fi
}

# ─── Main ────────────────────────────────────────────────────────────────────
main() {
  local command=""
  local update=false
  local force=false
  local dry_run=false
  local target=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --claude)   command="install"; shift ;;
      --remove)   command="remove"; shift ;;
      --update)   update=true; shift ;;
      --force)    force=true; shift ;;
      --dry-run)  dry_run=true; shift ;;
      --version)  echo "reforge v${FRAMEWORK_VERSION}"; exit 0 ;;
      --help|-h)  show_help; exit 0 ;;
      -*)         die "Unknown option: $1" ;;
      *)          target="$1"; shift ;;
    esac
  done

  # Default target to current directory
  if [[ -z "$target" ]]; then
    target="."
  fi

  # Resolve target to absolute path
  if [[ -d "$target" ]]; then
    target="$(cd "$target" && pwd)"
  fi

  # Require a command
  if [[ -z "$command" ]]; then
    show_help
    exit 1
  fi

  # Validate source framework
  validate_source

  # Validate target
  validate_target "$target"

  # Execute
  case "$command" in
    install)
      if [[ "$update" == "true" ]]; then
        do_update "$target" "$dry_run"
      else
        do_install "$target" "$dry_run"
      fi
      ;;
    remove)
      do_remove "$target" "$force" "$dry_run"
      ;;
  esac
}

main "$@"
