<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Business Rules Schema
  Defines structure for extracted business rules (business-rules.xml)
  Version: 1.0.0
  Namespace: http://reforge.dev/schema/extraction

  Shared types (ConfidenceType, SourceReferenceType, MetadataType)
  are defined in common-schema.xsd and included via xs:include.
  Authoritative definition: ../common-schema.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/extraction"
           targetNamespace="http://reforge.dev/schema/extraction"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common-schema.xsd"/>

  <!-- Root Element -->
  <xs:element name="business-rules">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="rf:MetadataType"/>
        <xs:element name="rule" type="rf:BusinessRuleType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="rf:CommonRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Business Rule -->
  <xs:complexType name="BusinessRuleType">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="logic" type="xs:string"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
      <xs:element name="entities" type="rf:EntitiesRefType" minOccurs="0"/>
      <xs:element name="related-rules" type="rf:RelatedRulesType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Entity References -->
  <xs:complexType name="EntitiesRefType">
    <xs:sequence>
      <xs:element name="entity" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Related Rules -->
  <xs:complexType name="RelatedRulesType">
    <xs:sequence>
      <xs:element name="rule-ref" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="relationship" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
