<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Non-Functional Requirements Schema
  Defines structure for extracted non-functional requirements and security findings (non-functional-requirements.xml)
  Version: 1.0.0
  Namespace: http://reforge.dev/schema/extraction

  Shared types (ConfidenceType, SourceReferenceType, MetadataType)
  are defined in common-schema.xsd and included via xs:include.
  Authoritative definition: ../common-schema.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/extraction"
           targetNamespace="http://reforge.dev/schema/extraction"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common-schema.xsd"/>

  <!-- Root Element -->
  <xs:element name="non-functional-requirements">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="rf:MetadataType"/>
        <xs:element name="requirements" type="rf:NFRRequirementsContainerType" minOccurs="0"/>
        <xs:element name="findings" type="rf:FindingsContainerType" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="rf:CommonRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Requirements Container -->
  <xs:complexType name="NFRRequirementsContainerType">
    <xs:sequence>
      <xs:element name="requirement" type="rf:NFRequirementType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Non-Functional Requirement -->
  <xs:complexType name="NFRequirementType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="metric" minOccurs="0">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required"/>
          <xs:attribute name="threshold" type="xs:string" use="required"/>
          <xs:attribute name="unit" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Findings Container -->
  <xs:complexType name="FindingsContainerType">
    <xs:sequence>
      <xs:element name="finding" type="rf:SecurityFindingType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Security Finding -->
  <xs:complexType name="SecurityFindingType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="cwe-id" type="xs:string" minOccurs="0"/>
      <xs:element name="affected-component" type="xs:string"/>
      <xs:element name="remediation" type="xs:string"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="severity" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

</xs:schema>
