<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Issues Schema
  Defines structure for extracted bugs and issues (issues.xml)
  Version: 1.0.0
  Namespace: http://reforge.dev/schema/extraction

  Shared types (ConfidenceType, SourceReferenceType, MetadataType)
  are defined in common-schema.xsd and included via xs:include.
  Authoritative definition: ../common-schema.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/extraction"
           targetNamespace="http://reforge.dev/schema/extraction"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common-schema.xsd"/>

  <!-- Root Element -->
  <xs:element name="issues">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="rf:MetadataType"/>
        <xs:element name="bugs" type="rf:BugsContainerType" minOccurs="0"/>
        <xs:element name="issues-list" type="rf:IssuesListContainerType" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="rf:CommonRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Bugs Container -->
  <xs:complexType name="BugsContainerType">
    <xs:sequence>
      <xs:element name="bug" type="rf:BugType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Bug -->
  <xs:complexType name="BugType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="detection-method" type="xs:string"/>
      <xs:element name="impact" type="xs:string"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="severity" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Issues List Container -->
  <xs:complexType name="IssuesListContainerType">
    <xs:sequence>
      <xs:element name="issue" type="rf:IssueType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Issue -->
  <xs:complexType name="IssueType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="issue-type" type="xs:string"/>
      <xs:element name="effort-estimate" type="xs:string"/>
      <xs:element name="recommendation" type="xs:string"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="severity" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

</xs:schema>
