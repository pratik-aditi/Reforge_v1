<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Architecture Schema
  Defines structure for extracted architecture components, integrations, and patterns (architecture.xml)
  Version: 1.0.0
  Namespace: http://reforge.dev/schema/extraction

  Shared types (ConfidenceType, SourceReferenceType, MetadataType)
  are defined in common-schema.xsd and included via xs:include.
  Authoritative definition: ../common-schema.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/extraction"
           targetNamespace="http://reforge.dev/schema/extraction"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common-schema.xsd"/>

  <!-- Root Element -->
  <xs:element name="architecture">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="rf:MetadataType"/>
        <xs:element name="components" type="rf:ComponentsContainerType" minOccurs="0"/>
        <xs:element name="integrations" type="rf:IntegrationsContainerType" minOccurs="0"/>
        <xs:element name="patterns" type="rf:PatternsContainerType" minOccurs="0"/>
      </xs:sequence>
      <xs:attributeGroup ref="rf:CommonRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Components Container -->
  <xs:complexType name="ComponentsContainerType">
    <xs:sequence>
      <xs:element name="component" type="rf:ArchComponentType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Architecture Component -->
  <xs:complexType name="ArchComponentType">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="technology" type="xs:string" minOccurs="0"/>
      <xs:element name="responsibilities" type="rf:ResponsibilitiesType" minOccurs="0"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="layer" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Responsibilities -->
  <xs:complexType name="ResponsibilitiesType">
    <xs:sequence>
      <xs:element name="responsibility" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Integrations Container -->
  <xs:complexType name="IntegrationsContainerType">
    <xs:sequence>
      <xs:element name="integration" type="rf:IntegrationType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Integration -->
  <xs:complexType name="IntegrationType">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="endpoint" type="xs:string" minOccurs="0"/>
      <xs:element name="direction" type="xs:string"/>
      <xs:element name="data-format" type="xs:string" minOccurs="0"/>
      <xs:element name="authentication" type="xs:string" minOccurs="0"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="protocol" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Patterns Container -->
  <xs:complexType name="PatternsContainerType">
    <xs:sequence>
      <xs:element name="pattern" type="rf:DesignPatternType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
  </xs:complexType>

  <!-- Design Pattern -->
  <xs:complexType name="DesignPatternType">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="implementation-notes" type="xs:string" minOccurs="0"/>
      <xs:element name="affected-components" type="rf:AffectedComponentsType" minOccurs="0"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="pattern-type" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Affected Components -->
  <xs:complexType name="AffectedComponentsType">
    <xs:sequence>
      <xs:element name="component-ref" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
