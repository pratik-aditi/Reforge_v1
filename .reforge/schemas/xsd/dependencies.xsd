<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Dependencies Schema
  Defines structure for extracted module dependencies (dependencies.xml)
  Version: 1.0.0
  Namespace: http://reforge.dev/schema/extraction

  Shared types (ConfidenceType, SourceReferenceType, MetadataType)
  are defined in common-schema.xsd and included via xs:include.
  Authoritative definition: ../common-schema.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/extraction"
           targetNamespace="http://reforge.dev/schema/extraction"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common-schema.xsd"/>

  <!-- Root Element -->
  <xs:element name="dependencies">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="rf:MetadataType"/>
        <xs:element name="dep-ref" type="rf:DependencyRefType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="rf:CommonRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Dependency Reference -->
  <xs:complexType name="DependencyRefType">
    <xs:sequence>
      <xs:element name="from-module" type="xs:string"/>
      <xs:element name="to-module" type="xs:string"/>
      <xs:element name="coupling" type="xs:string"/>
      <xs:element name="direction" type="xs:string"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="dependency-type" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

</xs:schema>
