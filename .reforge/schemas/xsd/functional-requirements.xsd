<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reforge Functional Requirements Schema
  Defines structure for extracted functional requirements (functional-requirements.xml)
  Version: 1.0.0
  Namespace: http://reforge.dev/schema/extraction

  Shared types (ConfidenceType, SourceReferenceType, MetadataType)
  are defined in common-schema.xsd and included via xs:include.
  Authoritative definition: ../common-schema.md
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:rf="http://reforge.dev/schema/extraction"
           targetNamespace="http://reforge.dev/schema/extraction"
           elementFormDefault="qualified">

  <xs:include schemaLocation="common-schema.xsd"/>

  <!-- Root Element -->
  <xs:element name="functional-requirements">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="metadata" type="rf:MetadataType"/>
        <xs:element name="requirement" type="rf:FunctionalRequirementType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attributeGroup ref="rf:CommonRootAttributes"/>
    </xs:complexType>
  </xs:element>

  <!-- Functional Requirement -->
  <xs:complexType name="FunctionalRequirementType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="description" type="xs:string"/>
      <xs:element name="acceptance-criteria" type="rf:AcceptanceCriteriaType" minOccurs="0"/>
      <xs:element name="source" type="rf:SourceReferenceType"/>
      <xs:element name="related-rules" type="rf:RelatedRulesRefType" minOccurs="0"/>
      <xs:element name="related-workflows" type="rf:RelatedWorkflowsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="category" type="xs:string" use="required"/>
    <xs:attribute name="priority" type="xs:string" use="required"/>
    <xs:attribute name="confidence" type="rf:ConfidenceType" use="required"/>
  </xs:complexType>

  <!-- Acceptance Criteria -->
  <xs:complexType name="AcceptanceCriteriaType">
    <xs:sequence>
      <xs:element name="criterion" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Related Rules References -->
  <xs:complexType name="RelatedRulesRefType">
    <xs:sequence>
      <xs:element name="rule-ref" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
          <xs:attribute name="relationship" type="xs:string"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Related Workflows -->
  <xs:complexType name="RelatedWorkflowsType">
    <xs:sequence>
      <xs:element name="workflow-ref" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
